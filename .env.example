# Supabase PostgreSQL connection used by Nakama at runtime.
# Use the session/direct-style Supabase URL on port 5432 and keep sslmode=require.
# Do not use the transaction pooler URL with pgbouncer=true on port 6543:
# Nakama uses prepared statements and will crash with PgBouncer transaction pooling.
DATABASE_URL=postgresql://postgres.lcqsxhuzafkqmumflntm:<SUPABASE_DB_PASSWORD>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Direct Supabase PostgreSQL URL used only for schema creation before migrations.
# This should also require SSL.
DIRECT_URL=postgresql://postgres.lcqsxhuzafkqmumflntm:<SUPABASE_DB_PASSWORD>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Keeps Nakama objects isolated from the expense_tracker schema in the same database.
NAKAMA_DB_SCHEMA=nakama

# Local docker compose ports. Render should provide PORT automatically.
PORT=7350
NAKAMA_CONSOLE_PORT=7351

# Replace every value below with a long random secret before production use.
NAKAMA_SERVER_KEY=replace-with-random-server-key
NAKAMA_RUNTIME_HTTP_KEY=replace-with-random-runtime-http-key
NAKAMA_SESSION_ENCRYPTION_KEY=replace-with-random-session-encryption-key
NAKAMA_REFRESH_ENCRYPTION_KEY=replace-with-random-refresh-encryption-key
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=replace-with-random-console-password
NAKAMA_CONSOLE_SIGNING_KEY=replace-with-random-console-signing-key
